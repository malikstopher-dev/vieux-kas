{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akglobal-trading",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ak-globaltrading.com"
  },
  "routes": [
    {
      "pattern": "www.ak-globaltrading.com/*",
      "zone_name": "ak-globaltrading.com"
    }
  ]
}
